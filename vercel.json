{
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "17 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/supabase/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://supabase.com"
        }
      ]
    }
  ]
}